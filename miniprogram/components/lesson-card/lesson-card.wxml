<!-- components/lesson-card/lesson-card.wxml -->
<view class="lesson-card status-{{lesson.status}}" bindtap="onTap">
  <view class="lc-left">
    <view class="lc-time">
      <text class="lc-time-text">{{lesson.start_time}} - {{lesson.end_time}}</text>
    </view>
    <text class="lc-location" wx:if="{{lesson.location}}">{{lesson.location}}</text>
  </view>
  <view class="lc-right">
    <text class="lc-student">{{lesson.student_name}}</text>
    <t-tag
      wx:if="{{lesson.status === 'pending'}}"
      theme="warning" variant="light" size="small"
    >待确认</t-tag>
    <t-tag
      wx:elif="{{lesson.status === 'confirmed'}}"
      theme="primary" variant="light" size="small"
    >已确认</t-tag>
    <t-tag
      wx:elif="{{lesson.status === 'completed'}}"
      theme="success" variant="light" size="small"
    >已完成</t-tag>
    <t-tag
      wx:elif="{{lesson.status === 'cancelled'}}"
      theme="default" variant="light" size="small"
    >已取消</t-tag>
  </view>
</view>
