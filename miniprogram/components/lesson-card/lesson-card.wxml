<!-- components/lesson-card/lesson-card.wxml -->
<view class="lesson-card status-{{lesson.status}}" bindtap="onTap">
  <view class="lc-left">
    <view class="lc-time">
      <text class="lc-time-text">{{lesson.start_time}} - {{lesson.end_time}}</text>
    </view>
    <text class="lc-location" wx:if="{{lesson.location}}">📍 {{lesson.location}}</text>
  </view>
  <view class="lc-right">
    <text class="lc-student">{{lesson.student_name}}</text>
    <view class="tag tag-{{lesson.status}}">
      <text wx:if="{{lesson.status === 'pending'}}">待确认</text>
      <text wx:elif="{{lesson.status === 'confirmed'}}">已确认</text>
      <text wx:elif="{{lesson.status === 'completed'}}">已完成</text>
      <text wx:elif="{{lesson.status === 'cancelled'}}">已取消</text>
    </view>
  </view>
</view>
