/* components/lesson-card/lesson-card.wxss — FORGE 主题 */

.lesson-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-md);
  background: var(--color-bg-white);
  border-radius: var(--td-radius-default);
  margin-bottom: var(--space-sm);
  box-shadow: var(--td-shadow-1);
  border-left: 6rpx solid var(--color-border);
  transition: transform 0.15s ease-out;
}

.lesson-card:active {
  transform: scale(0.98);
  background: var(--color-bg-active);
}

/* 状态左边框 */
.lesson-card.status-pending { border-left-color: var(--td-warning-color); }
.lesson-card.status-confirmed { border-left-color: var(--td-brand-color); }
.lesson-card.status-completed { border-left-color: var(--td-success-color); }
.lesson-card.status-cancelled { border-left-color: var(--color-text-muted); }

.lc-left {
  display: flex;
  flex-direction: column;
  flex: 1;
  overflow: hidden;
}

.lc-time-text {
  font-size: var(--text-md);
  font-weight: 600;
  color: var(--color-text);
}

.lc-location {
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

.lc-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.lc-student {
  font-size: var(--text-sm);
  color: var(--color-text);
  font-weight: 500;
  margin-bottom: var(--space-xs);
}
