/* components/student-picker/student-picker.wxss */

.picker-container {
  padding: 16rpx 0;
}

.picker-header {
  margin-bottom: 16rpx;
}

.picker-title {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--color-text);
}

.picker-list {
  max-height: 500rpx;
  overflow-y: auto;
}

.picker-item {
  display: flex;
  align-items: center;
  padding: 20rpx 12rpx;
  border-radius: var(--radius-sm);
  margin-bottom: 8rpx;
}

.picker-item.selected {
  background: var(--color-primary-light);
}

.picker-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--color-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.picker-avatar image {
  width: 100%;
  height: 100%;
}

.picker-avatar-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.picker-info {
  flex: 1;
  margin-left: 16rpx;
}

.picker-name {
  font-size: var(--font-md);
  font-weight: 500;
  color: var(--color-text);
}

.picker-meta {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  margin-top: 4rpx;
  display: block;
}

.picker-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
