<!-- components/student-picker/student-picker.wxml - 学员选择器 -->
<view class="picker-container">
  <view class="picker-header" wx:if="{{title}}">
    <text class="picker-title">{{title}}</text>
  </view>

  <view class="picker-list">
    <view
      class="picker-item {{item._id === selectedId ? 'selected' : ''}}"
      wx:for="{{students}}"
      wx:key="_id"
      bindtap="onSelect"
      data-id="{{item._id}}"
    >
      <view class="picker-avatar">
        <image wx:if="{{item.avatar_url}}" src="{{item.avatar_url}}" mode="aspectFill" />
        <text wx:else class="picker-avatar-text">{{item.name[0]}}</text>
      </view>
      <view class="picker-info">
        <text class="picker-name">{{item.name}}</text>
        <text class="picker-meta">剩余 {{item.remaining_lessons || 0}} 课时</text>
      </view>
      <view class="picker-check" wx:if="{{item._id === selectedId}}">✓</view>
    </view>
  </view>

  <view wx:if="{{students.length === 0 && !loading}}" class="text-muted text-sm text-center mt-24">
    暂无学员，请先在学员管理中添加
  </view>
</view>
