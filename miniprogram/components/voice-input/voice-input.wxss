/* components/voice-input/voice-input.wxss */

.voice-wrap {
  width: 100%;
}

/* ===== 录音按钮 ===== */
.voice-btn {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 200rpx;
  margin: 40rpx auto;
  border-radius: 50%;
  background: linear-gradient(135deg, #e8f0fe, #d4e4fc);
  border: 4rpx solid #c5d9f8;
  transition: all 0.3s ease;
}

.voice-btn.recording {
  background: linear-gradient(135deg, #ffe8e8, #ffd4d4);
  border-color: #ffb8b8;
  transform: scale(1.1);
}

.voice-btn.recognizing {
  background: linear-gradient(135deg, #fef3e8, #fce4c8);
  border-color: #f0c890;
}

.voice-icon {
  font-size: 56rpx;
  z-index: 2;
}

.voice-label {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6b7280;
  z-index: 2;
}

/* ===== 录音波纹动画 ===== */
.voice-ripple {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.ripple {
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 3rpx solid #ff6b6b;
  animation: ripple-anim 1.5s ease-out infinite;
}

.r1 { animation-delay: 0s; }
.r2 { animation-delay: 0.5s; }
.r3 { animation-delay: 1s; }

@keyframes ripple-anim {
  0% {
    width: 200rpx;
    height: 200rpx;
    opacity: 1;
    margin-top: 0;
    margin-left: 0;
  }
  100% {
    width: 400rpx;
    height: 400rpx;
    opacity: 0;
    margin-top: -100rpx;
    margin-left: -100rpx;
  }
}

/* ===== 完成状态：文本输入 ===== */
.voice-done {
  padding: 24rpx;
}

.voice-done-header {
  margin-bottom: 16rpx;
}

.voice-done-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.voice-done-hint {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.voice-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.voice-actions {
  display: flex;
  margin-top: 20rpx;
}
