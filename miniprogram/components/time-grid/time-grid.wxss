/* components/time-grid/time-grid.wxss */
.time-grid-container {
  padding: 16rpx 0;
}

.time-grid-header {
  margin-bottom: 16rpx;
}

.time-grid-title {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--color-text);
}

.time-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.time-slot {
  padding: 16rpx 12rpx;
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  font-size: var(--font-xs);
  color: var(--color-text);
  text-align: center;
  min-width: 100rpx;
  position: relative;
  border: 2rpx solid transparent;
  transition: all 0.15s;
}

.time-slot.active {
  background: var(--color-primary);
  color: #fff;
  border-color: var(--color-primary);
  font-weight: 600;
}

.time-slot.range-active {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.time-slot.disabled {
  background: var(--color-divider);
  color: var(--color-text-light);
}

.slot-end {
  font-size: 18rpx;
  opacity: 0.7;
  display: block;
}

.time-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: var(--color-primary-light);
  border-radius: var(--radius-sm);
}

.time-summary-text {
  font-size: var(--font-sm);
  color: var(--color-primary);
  font-weight: 500;
}

.time-summary-clear {
  font-size: var(--font-xs);
  color: var(--color-primary);
  padding: 4rpx 12rpx;
}
