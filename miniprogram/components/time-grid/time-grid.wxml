<!-- components/time-grid/time-grid.wxml -->
<view class="time-grid-container">
  <view class="time-grid-header" wx:if="{{title}}">
    <text class="time-grid-title">{{title}}</text>
  </view>
  <view class="time-grid">
    <view
      class="time-slot {{item.active ? 'active' : ''}} {{item.rangeActive && !item.active ? 'range-active' : ''}} {{item.disabled ? 'disabled' : ''}}"
      wx:for="{{slotItems}}"
      wx:key="value"
      data-time="{{item.value}}"
      bindtap="onTapSlot"
    >
      <text>{{item.value}}</text>
    </view>
  </view>
  <view class="time-summary" wx:if="{{selectedStart}}">
    <text class="time-summary-text">{{selectedStart}} - {{selectedEnd && slotIndexMap[selectedEnd] !== undefined ? slotItems[slotIndexMap[selectedEnd]].endTime : selectedStart}}</text>
    <text class="time-summary-clear" bindtap="onClear">清除</text>
  </view>
</view>
