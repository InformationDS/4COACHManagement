/* custom-tab-bar/index.wxss */
.tab-bar {
  display: flex;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #ffffff;
  border-top: 1rpx solid #E5E7EB;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: color 0.15s;
}

.tab-text {
  font-size: 26rpx;
  color: #9CA3AF;
  line-height: 100rpx;
}

.tab-item.active .tab-text {
  color: #FF6B35;
  font-weight: 600;
}
