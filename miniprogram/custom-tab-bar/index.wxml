<!-- custom-tab-bar/index.wxml - 教练单人模式 tabBar -->
<view class="tab-bar">
  <view
    class="tab-item {{selected === index ? 'active' : ''}}"
    wx:for="{{tabs}}"
    wx:key="pagePath"
    data-index="{{index}}"
    data-path="{{item.pagePath}}"
    bindtap="onTap"
  >
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
