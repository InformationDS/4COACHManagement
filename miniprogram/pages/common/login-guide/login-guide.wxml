<!-- pages/common/login-guide/login-guide.wxml - 未注册引导页 -->
<view class="guide-container">
  <view class="guide-content">
    <!-- 品牌区 -->
    <view class="guide-brand">
      <text class="guide-icon">💪</text>
      <text class="guide-title">私教助手</text>
      <text class="guide-desc">自由私人教练的得力工具</text>
    </view>

    <!-- 教练注册入口 -->
    <view class="guide-section">
      <view class="guide-section-title">我是教练</view>
      <view class="guide-section-body">
        <text class="guide-text">首次使用请绑定教练身份，然后即可管理学员和课程。</text>
        <button class="btn btn-primary btn-block mt-24" bindtap="onBindCoach" loading="{{binding}}">
          {{binding ? '绑定中...' : '绑定教练身份'}}
        </button>
      </view>
    </view>

    <!-- 学员提示 -->
    <view class="guide-section divider-top">
      <view class="guide-section-title">我是学员</view>
      <view class="guide-section-body">
        <text class="guide-text">请联系您的教练，教练添加您的信息后，您即可登录使用。</text>
        <view class="guide-tip mt-16">
          <text class="guide-tip-text">💡 提示：如果您已经收到教练的邀请，退出重进即可自动识别。</text>
        </view>
      </view>
    </view>

    <!-- 重新检测 -->
    <view class="guide-footer">
      <button class="btn btn-ghost btn-block" bindtap="onRetry">
        已有账号？重新检测
      </button>
    </view>
  </view>
</view>
