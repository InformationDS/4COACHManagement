/* pages/common/login-guide/login-guide.wxss — FORGE 主题 */

.guide-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1A1A2E 0%, #2D1A2E 30%, var(--color-bg) 30%);
  padding: 60rpx var(--space-lg) calc(env(safe-area-inset-bottom) + 120rpx);
}

.guide-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
}

.guide-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.guide-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 8rpx;
}

.guide-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 12rpx;
}

.guide-section {
  background: var(--color-bg-white);
  border-radius: var(--td-radius-large);
  padding: var(--space-lg);
  margin-bottom: var(--space-md);
  box-shadow: var(--td-shadow-1);
}

.guide-section-title {
  font-size: var(--text-lg);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: var(--space-sm);
  padding-bottom: var(--space-sm);
  border-bottom: 1rpx solid var(--color-divider);
}

.guide-text {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  line-height: 1.8;
}

.guide-tip {
  background: var(--color-brand-light);
  border-radius: var(--td-radius-small);
  padding: var(--space-sm) var(--space-md);
}

.guide-tip-text {
  font-size: var(--text-xs);
  color: var(--color-brand);
}

.guide-footer {
  margin-top: 40rpx;
}

.divider-top {
  border-top: none;
}
