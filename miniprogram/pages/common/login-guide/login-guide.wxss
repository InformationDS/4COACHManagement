/* pages/common/login-guide/login-guide.wxss */

.guide-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 40%, var(--color-bg) 40%);
  padding: 60rpx 32rpx calc(env(safe-area-inset-bottom) + 120rpx);
}

.guide-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
}

.guide-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.guide-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 8rpx;
}

.guide-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 12rpx;
}

.guide-section {
  background: var(--color-bg-white);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.guide-section-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--color-divider);
}

.guide-text {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.8;
}

.guide-tip {
  background: var(--color-primary-light);
  border-radius: var(--radius-sm);
  padding: 16rpx 24rpx;
}

.guide-tip-text {
  font-size: var(--font-xs);
  color: var(--color-primary);
}

.guide-footer {
  margin-top: 40rpx;
}

.divider-top {
  border-top: none;
}
