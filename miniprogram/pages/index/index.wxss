/* pages/index/index.wxss - 启动闪屏页 — FORGE 主题 */

.splash-container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #1A1A2E 0%, #2D1A2E 40%, #FF6B35 100%);
}

.splash-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx;
}

.splash-logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.splash-icon {
  font-size: 120rpx;
  margin-bottom: var(--space-md);
}

.splash-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 8rpx;
}

.splash-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: var(--space-sm);
}

.splash-status {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-text {
  color: rgba(255, 255, 255, 0.6);
  font-size: var(--text-md);
  margin-top: var(--space-md);
}

.splash-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.splash-welcome {
  font-size: var(--text-lg);
  color: #FFFFFF;
  font-weight: 500;
}

.splash-tip {
  font-size: var(--text-md);
  color: rgba(255, 255, 255, 0.6);
  text-align: center;
  line-height: 1.8;
}
