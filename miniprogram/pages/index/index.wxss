/* pages/index/index.wxss - 启动闪屏页 */

.splash-container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
}

.splash-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx;
}

.splash-logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.splash-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.splash-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 8rpx;
}

.splash-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 16rpx;
}

.splash-status {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  color: rgba(255, 255, 255, 0.6);
  font-size: 28rpx;
  margin-top: 24rpx;
}

.splash-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.splash-welcome {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 500;
}

.splash-tip {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  text-align: center;
  line-height: 1.8;
}
