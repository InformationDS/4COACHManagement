<!-- pages/student/lesson-detail/lesson-detail.wxml -->
<view class="container">
  <view wx:if="{{loading}}" class="loading-wrap">
    <t-loading theme="circular" size="48rpx" text="加载中..." />
  </view>

  <block wx:if="{{!loading && lesson._id}}">
    <!-- 课程信息卡片 -->
    <view class="detail-card">
      <view class="detail-header">
        <t-tag wx:if="{{lesson.status==='pending'}}" theme="warning" variant="light" size="medium">待确认</t-tag>
        <t-tag wx:elif="{{lesson.status==='confirmed'}}" theme="primary" variant="light" size="medium">已确认</t-tag>
        <t-tag wx:elif="{{lesson.status==='completed'}}" theme="success" variant="light" size="medium">已完成</t-tag>
        <t-tag wx:elif="{{lesson.status==='cancelled'}}" theme="default" variant="light" size="medium">已取消</t-tag>
      </view>
      <view class="detail-row"><text class="dl">日期</text><text class="dv">{{lesson.date}}</text></view>
      <view class="detail-row"><text class="dl">时间</text><text class="dv">{{lesson.start_time}} - {{lesson.end_time}}</text></view>
      <view class="detail-row"><text class="dl">地点</text><text class="dv">{{lesson.location || '未指定'}}</text></view>
      <view wx:if="{{lesson.cancel_reason}}" class="detail-row"><text class="dl">取消原因</text><text class="dv text-muted">{{lesson.cancel_reason}}</text></view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-bar" wx:if="{{lesson.status==='pending' || lesson.status==='confirmed'}}">
      <block wx:if="{{lesson.status==='pending' && lesson.initiated_by==='coach'}}">
        <t-button theme="primary" size="large" block bind:tap="onConfirm">确认课程</t-button>
        <t-button theme="default" variant="outline" size="large" block style="margin-top: var(--space-sm)" bind:tap="onCancel">暂不参加</t-button>
      </block>
      <block wx:elif="{{lesson.status==='pending' && lesson.initiated_by==='student'}}">
        <t-button theme="default" variant="outline" size="large" block bind:tap="onCancel">取消约课</t-button>
      </block>
      <block wx:elif="{{lesson.status==='confirmed'}}">
        <t-button theme="default" variant="outline" size="large" block bind:tap="onCancel">取消课程</t-button>
      </block>
    </view>

    <!-- 训练记录 -->
    <view class="detail-card mt-24" wx:if="{{lesson.status==='completed'}}">
      <view class="card-header">训练记录</view>
      <block wx:if="{{trainingRecord}}">
        <view class="train-section" wx:if="{{trainingRecord.body_parts.length > 0}}">
          <text class="train-label">训练部位</text>
          <view class="train-tags">
            <text class="tag-text" wx:for="{{trainingRecord.body_parts}}" wx:key="*this">{{item}}</text>
          </view>
        </view>
        <view class="train-section" wx:if="{{trainingRecord.exercises.length > 0}}">
          <text class="train-label">动作明细</text>
          <view class="ex-row" wx:for="{{trainingRecord.exercises}}" wx:key="index">
            <text class="ex-name">{{item.name}}</text>
            <text class="ex-data">{{item.sets}}×{{item.reps}} {{item.weight}}</text>
          </view>
        </view>
        <view class="train-section" wx:if="{{trainingRecord.notes}}">
          <text class="train-label">课堂备注</text>
          <text class="train-notes">{{trainingRecord.notes}}</text>
        </view>
      </block>
      <view wx:else class="text-muted text-sm text-center py-24">暂无训练记录</view>
    </view>
  </block>

  <!-- ===== 取消课程弹窗 ===== -->
  <t-dialog
    visible="{{showCancelModal}}"
    title="取消课程"
    confirm-btn="确认取消"
    cancel-btn="返回"
    bind:confirm="onConfirmCancel"
    bind:cancel="onCloseCancelModal"
    bind:close="onCloseCancelModal"
  >
    <view class="cancel-dialog-body" slot="content">
      <text class="form-label">取消原因（选填）</text>
      <textarea
        class="form-textarea"
        placeholder="请输入取消原因（如：临时有事、身体不适...）"
        value="{{cancelReason}}"
        bindinput="onCancelReasonInput"
        maxlength="100"
        auto-height
      ></textarea>
    </view>
  </t-dialog>
</view>
