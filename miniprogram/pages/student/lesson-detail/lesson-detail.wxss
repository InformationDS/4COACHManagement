.detail-header{text-align:right;margin-bottom:16rpx}.detail-row{display:flex;justify-content:space-between;padding:16rpx 0;border-bottom:1rpx solid var(--color-divider)}.dl{font-size:var(--font-sm);color:var(--color-text-secondary)}.dv{font-size:var(--font-sm);font-weight:500}.action-bar{padding:24rpx 0}.train-section{margin-top:20rpx}.train-label{font-size:var(--font-xs);color:var(--color-text-light);margin-bottom:8rpx;display:block}.train-tags{display:flex;gap:12rpx;flex-wrap:wrap}.tag-text{background:var(--color-primary-light);color:var(--color-primary);padding:6rpx 20rpx;border-radius:20rpx;font-size:var(--font-xs)}.ex-row{display:flex;justify-content:space-between;padding:10rpx 0;border-bottom:1rpx dashed var(--color-divider)}.ex-name{font-size:var(--font-sm)}.ex-data{font-size:var(--font-sm);color:var(--color-text-secondary)}.train-notes{font-size:var(--font-sm);color:var(--color-text);line-height:1.8;white-space:pre-wrap}.py-24{padding:24rpx 0}
