.container-booking{padding:24rpx 24rpx calc(env(safe-area-inset-bottom) + 160rpx)}.section-header{display:flex;justify-content:space-between;align-items:center;padding:16rpx 0}.section-title{font-size:var(--font-md);font-weight:600}.today-lessons{margin-bottom:8rpx}.tlesson-card{display:flex;background:var(--color-bg-white);border-radius:var(--radius-md);margin-bottom:12rpx;overflow:hidden;box-shadow:var(--shadow-sm)}.tl-status{width:8rpx;flex-shrink:0}.tl-status.pending{background:var(--color-warning)}.tl-status.confirmed{background:var(--color-primary)}.tl-status.completed{background:var(--color-success)}.tl-status.cancelled{background:var(--color-text-light)}.tl-body{flex:1;padding:20rpx 24rpx}.tl-row{display:flex;justify-content:space-between;align-items:center}.tl-time{font-size:var(--font-md);font-weight:600}.tl-location{font-size:var(--font-xs);color:var(--color-text-secondary);margin-top:6rpx}.book-summary{background:var(--color-bg-white);border-radius:var(--radius-md);padding:24rpx;margin-top:24rpx;box-shadow:var(--shadow-sm)}.summary-row{display:flex;justify-content:space-between;padding:12rpx 0;border-bottom:1rpx solid var(--color-divider)}.summary-label{font-size:var(--font-sm);color:var(--color-text-secondary)}.summary-value{font-size:var(--font-sm);font-weight:600}
