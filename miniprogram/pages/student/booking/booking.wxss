/* pages/student/booking/booking.wxss — FORGE 主题 */

.container-booking {
  padding: var(--space-md) var(--space-md) calc(env(safe-area-inset-bottom) + 160rpx);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-sm) 0;
}

.section-title {
  font-size: var(--text-md);
  font-weight: 600;
  color: var(--color-text);
}

.today-lessons {
  margin-bottom: var(--space-xs);
}

.tlesson-card {
  display: flex;
  background: var(--color-bg-white);
  border-radius: var(--td-radius-default);
  margin-bottom: 12rpx;
  overflow: hidden;
  box-shadow: var(--td-shadow-1);
}

.tl-status {
  width: 8rpx;
  flex-shrink: 0;
}

.tl-status.pending { background: var(--color-warning); }
.tl-status.confirmed { background: var(--color-brand); }
.tl-status.completed { background: var(--color-success); }
.tl-status.cancelled { background: var(--color-text-muted); }

.tl-body {
  flex: 1;
  padding: 20rpx var(--space-md);
}

.tl-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tl-time {
  font-size: var(--text-md);
  font-weight: 600;
  color: var(--color-text);
}

.tl-location {
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

.book-summary {
  background: var(--color-bg-white);
  border-radius: var(--td-radius-default);
  padding: var(--space-md);
  margin-top: var(--space-md);
  box-shadow: var(--td-shadow-1);
}

.summary-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.summary-label {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
}

.summary-value {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--color-text);
}
