<!-- pages/student/my-lessons/my-lessons.wxml -->
<view class="container-lessons">
  <view class="tab-row">
    <view class="tab-item {{activeTab==='upcoming'?'active':''}}" bindtap="onTabTap" data-tab="upcoming">待上课</view>
    <view class="tab-item {{activeTab==='history'?'active':''}}" bindtap="onTabTap" data-tab="history">历史</view>
  </view>

  <view wx:if="{{showList.length > 0}}">
    <view class="lesson-card" wx:for="{{showList}}" wx:key="_id" bindtap="onTap" data-id="{{item._id}}">
      <view class="lc-status {{item.status}}"></view>
      <view class="lc-body">
        <view class="lc-top">
          <text class="lc-date">{{item.dateText}}</text>
          <t-tag wx:if="{{item.status==='pending'}}" theme="warning" variant="light" size="small">待确认</t-tag>
          <t-tag wx:elif="{{item.status==='confirmed'}}" theme="primary" variant="light" size="small">已确认</t-tag>
          <t-tag wx:elif="{{item.status==='completed'}}" theme="success" variant="light" size="small">已完成</t-tag>
          <t-tag wx:elif="{{item.status==='cancelled'}}" theme="default" variant="light" size="small">已取消</t-tag>
        </view>
        <view class="lc-mid">
          <text class="lc-time">{{item.start_time}} - {{item.end_time}}</text>
        </view>
        <text class="lc-location" wx:if="{{item.location}}">📍 {{item.location}}</text>
      </view>
    </view>
  </view>
  <view wx:else class="empty-wrap">
    <t-empty
      icon="{{activeTab==='upcoming'?'calendar':'history'}}"
      description="{{activeTab==='upcoming'?'暂无待上课程':'暂无课程历史'}}"
    />
  </view>
</view>
