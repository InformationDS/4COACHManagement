.container-lessons{padding:0 24rpx 160rpx}.tab-row{display:flex;background:var(--color-bg-white);border-radius:var(--radius-md);padding:8rpx;margin:20rpx 0;box-shadow:var(--shadow-sm)}.tab-item{flex:1;text-align:center;padding:16rpx;font-size:var(--font-sm);color:var(--color-text-secondary);border-radius:var(--radius-sm)}.tab-item.active{background:var(--color-primary);color:#fff;font-weight:600}.lesson-card{display:flex;background:var(--color-bg-white);border-radius:var(--radius-md);margin-bottom:16rpx;overflow:hidden;box-shadow:var(--shadow-sm)}.lc-status{width:8rpx;flex-shrink:0}.lc-status.pending{background:var(--color-warning)}.lc-status.confirmed{background:var(--color-primary)}.lc-status.completed{background:var(--color-success)}.lc-status.cancelled{background:var(--color-text-light)}.lc-body{flex:1;padding:24rpx}.lc-top{display:flex;justify-content:space-between;align-items:center}.lc-date{font-size:var(--font-md);font-weight:600}.lc-mid{margin-top:8rpx}.lc-time{font-size:var(--font-sm);color:var(--color-text)}.lc-location{font-size:var(--font-xs);color:var(--color-text-secondary);margin-top:6rpx}
