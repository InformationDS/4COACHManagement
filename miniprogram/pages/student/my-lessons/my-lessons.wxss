/* pages/student/my-lessons/my-lessons.wxss — FORGE 主题 */

.container-lessons {
  padding: 0 var(--space-md) calc(env(safe-area-inset-bottom) + 160rpx);
}

/* ===== Tab 切换 ===== */
.tab-row {
  display: flex;
  background: var(--color-bg-white);
  border-radius: var(--td-radius-default);
  padding: var(--space-xs);
  margin: 20rpx 0;
  box-shadow: var(--td-shadow-1);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: var(--space-sm);
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  border-radius: var(--td-radius-small);
  transition: all 0.2s;
}

.tab-item.active {
  background: var(--color-brand);
  color: #fff;
  font-weight: 600;
}

/* ===== 课程卡片 ===== */
.lesson-card {
  display: flex;
  background: var(--color-bg-white);
  border-radius: var(--td-radius-default);
  margin-bottom: var(--space-sm);
  overflow: hidden;
  box-shadow: var(--td-shadow-1);
}

.lc-status {
  width: 8rpx;
  flex-shrink: 0;
}

.lc-status.pending { background: var(--color-warning); }
.lc-status.confirmed { background: var(--color-brand); }
.lc-status.completed { background: var(--color-success); }
.lc-status.cancelled { background: var(--color-text-muted); }

.lc-body {
  flex: 1;
  padding: var(--space-md);
}

.lc-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.lc-date {
  font-size: var(--text-md);
  font-weight: 600;
  color: var(--color-text);
}

.lc-mid {
  margin-top: var(--space-xs);
}

.lc-time {
  font-size: var(--text-sm);
  color: var(--color-text);
}

.lc-location {
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

/* ===== 空状态 ===== */
.empty-wrap {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}
