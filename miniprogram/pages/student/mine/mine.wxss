/* pages/student/mine/mine.wxss — FORGE 主题 */

.container-mine {
  padding: 0 var(--space-md) calc(env(safe-area-inset-bottom) + 160rpx);
}

/* ===== 头部 ===== */
.mine-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 20rpx;
}

.mine-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--color-brand-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-sm);
  box-shadow: var(--td-shadow-1);
}

.mine-avatar image {
  width: 100%;
  height: 100%;
}

.avatar-text {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--color-brand);
}

.mine-name {
  font-size: var(--text-xl);
  font-weight: 600;
  color: var(--color-text);
}

.mine-phone {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

/* ===== 课时变动记录 ===== */
.section-title-sm {
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: var(--space-xs);
  display: block;
}

.log-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-sm) 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.log-left {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.log-reason {
  font-size: var(--text-sm);
  color: var(--color-text);
}

.log-date {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  margin-top: 4rpx;
}

.log-num {
  font-size: var(--text-md);
  font-weight: 600;
  flex-shrink: 0;
  margin-left: var(--space-md);
}

/* ===== Dialog 内容 ===== */
.dialog-body {
  padding: var(--space-xs) 0;
}
