.container-mine{padding:0 24rpx 160rpx}.mine-header{display:flex;flex-direction:column;align-items:center;padding:40rpx 0 20rpx}.mine-avatar{width:120rpx;height:120rpx;border-radius:50%;overflow:hidden;background:var(--color-primary-light);display:flex;align-items:center;justify-content:center;margin-bottom:16rpx}.mine-avatar image{width:100%;height:100%}.avatar-text{font-size:48rpx;font-weight:600;color:var(--color-primary)}.mine-name{font-size:var(--font-xl);font-weight:600}.mine-phone{font-size:var(--font-sm);color:var(--color-text-secondary);margin-top:6rpx}.lessons-big{font-size:72rpx;font-weight:700;color:var(--color-primary);text-align:center;line-height:1;margin-top:8rpx}.lessons-label{text-align:center;font-size:var(--font-xs);color:var(--color-text-light);margin-top:8rpx}.section-title-sm{font-size:var(--font-xs);font-weight:600;color:var(--color-text);margin-bottom:8rpx;display:block}.log-item{display:flex;justify-content:space-between;align-items:center;padding:16rpx 0;border-bottom:1rpx solid var(--color-divider)}.log-left{display:flex;flex-direction:column}.log-reason{font-size:var(--font-sm);color:var(--color-text)}.log-date{font-size:var(--font-xs);color:var(--color-text-light);margin-top:4rpx}.log-num{font-size:var(--font-md);font-weight:600}
