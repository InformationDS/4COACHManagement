.container-mine{padding:0 24rpx calc(env(safe-area-inset-bottom) + 160rpx)}.mine-header{display:flex;flex-direction:column;align-items:center;padding:40rpx 0 20rpx}.mine-avatar{width:120rpx;height:120rpx;border-radius:50%;overflow:hidden;background:var(--color-primary-light);display:flex;align-items:center;justify-content:center;margin-bottom:16rpx}.mine-avatar image{width:100%;height:100%}.avatar-text{font-size:48rpx;font-weight:600;color:var(--color-primary)}.mine-name{font-size:var(--font-xl);font-weight:600}.mine-phone{font-size:var(--font-sm);color:var(--color-text-secondary);margin-top:6rpx}.lessons-big{font-size:72rpx;font-weight:700;color:var(--color-primary);text-align:center;line-height:1;margin-top:8rpx}.lessons-label{text-align:center;font-size:var(--font-xs);color:var(--color-text-light);margin-top:8rpx}.section-title-sm{font-size:var(--font-xs);font-weight:600;color:var(--color-text);margin-bottom:8rpx;display:block}.log-item{display:flex;justify-content:space-between;align-items:center;padding:16rpx 0;border-bottom:1rpx solid var(--color-divider)}.log-left{display:flex;flex-direction:column}.log-reason{font-size:var(--font-sm);color:var(--color-text)}.log-date{font-size:var(--font-xs);color:var(--color-text-light);margin-top:4rpx}.log-num{font-size:var(--font-md);font-weight:600}

/* 弹窗 */
.modal-wrapper{position:fixed;top:0;left:0;right:0;bottom:0;z-index:1000}
.modal-mask{position:absolute;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5)}
.modal-center{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:600rpx;z-index:1}
.modal-content{background:#fff;border-radius:var(--radius-lg);padding:40rpx 32rpx}
.modal-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:8rpx}
.modal-title{font-size:var(--font-lg);font-weight:600}
.modal-close{width:48rpx;height:48rpx;display:flex;align-items:center;justify-content:center;font-size:32rpx;color:var(--color-text-light)}
.modal-actions{display:flex}
