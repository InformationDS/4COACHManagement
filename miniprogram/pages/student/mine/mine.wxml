<!-- pages/student/mine/mine.wxml -->
<view class="container-mine">
  <!-- 头部 -->
  <view class="mine-header">
    <view class="mine-avatar">
      <image wx:if="{{student.avatar_url}}" src="{{student.avatar_url}}" mode="aspectFill" />
      <text wx:else class="avatar-text">{{student.name ? student.name[0] : '?'}}</text>
    </view>
    <text class="mine-name">{{student.name || '学员'}}</text>
    <text class="mine-phone" wx:if="{{student.phone}}">{{student.phone}}</text>
  </view>

  <!-- 课时卡 -->
  <view class="card mt-24">
    <view class="card-header">我的课时卡</view>
    <view class="hero-number">{{student.remaining_lessons || 0}}</view>
    <view class="hero-label">剩余课时</view>
    <view wx:if="{{logs.length > 0}}" class="mt-24">
      <text class="section-title-sm">变动记录</text>
      <view class="log-item" wx:for="{{logs}}" wx:key="_id">
        <view class="log-left">
          <text class="log-reason">{{item.reason || '无备注'}}</text>
          <text class="log-date">{{item.timeText}}</text>
        </view>
        <text class="log-num {{item.change_amount > 0 ? 'text-success' : 'text-danger'}}">{{item.change_amount > 0 ? '+' : ''}}{{item.change_amount}}</text>
      </view>
    </view>
  </view>

  <!-- 可编辑信息 -->
  <view class="card mt-24">
    <view class="list-item list-item-arrow" bindtap="onEditLocation">
      <text>上课地点偏好</text>
      <text class="text-muted text-sm">{{student.location_preference || '未设置，点击编辑'}}</text>
    </view>
    <view class="list-item list-item-arrow" bindtap="onEditNotes">
      <text>特殊诉求</text>
      <text class="text-muted text-sm">{{student.notes || '未设置，点击编辑'}}</text>
    </view>
  </view>

  <!-- ===== 编辑弹窗 ===== -->
  <t-dialog
    visible="{{editModalVisible}}"
    title="编辑{{editLabel}}"
    confirm-btn="保存"
    cancel-btn="取消"
    bind:confirm="onSaveEdit"
    bind:cancel="onCloseEdit"
    bind:close="onCloseEdit"
  >
    <view class="dialog-body" slot="content">
      <textarea
        wx:if="{{editField === 'notes'}}"
        class="form-textarea"
        placeholder="请输入特殊诉求（如伤病、训练目标、饮食要求等）"
        value="{{editValue}}"
        bindinput="onEditInput"
        maxlength="200"
        auto-height
      />
      <input
        wx:else
        class="form-input"
        placeholder="请输入上课地点偏好"
        value="{{editValue}}"
        bindinput="onEditInput"
        maxlength="50"
      />
    </view>
  </t-dialog>
</view>
