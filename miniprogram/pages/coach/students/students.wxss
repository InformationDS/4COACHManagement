/* pages/coach/students/students.wxss — FORGE 主题 */

/* ===== 搜索栏 ===== */
.search-bar {
  padding: 20rpx 0;
}

/* ===== 学员列表 ===== */
.student-list {
  margin-top: var(--space-xs);
}

.student-card {
  display: flex;
  align-items: center;
  background: var(--color-bg-white);
  border-radius: var(--td-radius-default);
  padding: var(--space-md);
  margin-bottom: var(--space-sm);
  box-shadow: var(--td-shadow-1);
  position: relative;
  transition: transform 0.15s ease-out;
}

.student-card:active {
  transform: scale(0.98);
  background: var(--color-bg-active);
}

/* ===== 头像 ===== */
.student-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--color-brand-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.student-avatar image {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-brand);
}

/* ===== 学员信息 ===== */
.student-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.student-name {
  font-size: var(--text-lg);
  font-weight: 600;
  color: var(--color-text);
}

.student-meta {
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

/* ===== 剩余课时 ===== */
.student-lessons {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: var(--space-sm);
  flex-shrink: 0;
}

.lessons-count {
  font-size: var(--text-xl);
  font-weight: 700;
  color: var(--color-brand);
  line-height: 1;
}

.lessons-label {
  font-size: 20rpx;
  color: var(--color-text-muted);
  margin-top: 4rpx;
}

/* ===== 箭头 ===== */
.arrow {
  font-size: 36rpx;
  color: var(--color-text-muted);
  font-weight: 300;
}

/* ===== 加载 & 空状态 ===== */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

/* ===== 自定义 FAB ===== */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: var(--color-brand);
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.35);
  z-index: 100;
  transition: transform 0.15s ease-out;
}

.fab:active {
  transform: scale(0.93);
}

.fab-icon {
  font-size: 44rpx;
  font-weight: 300;
  color: #fff;
  line-height: 1;
}

.fab-text {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 2rpx;
}
