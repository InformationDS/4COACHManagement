/* pages/coach/students/students.wxss */

/* 搜索栏 */
.search-bar {
  padding: 20rpx 0;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background: var(--color-bg-white);
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
  box-shadow: var(--shadow-sm);
}

.search-icon {
  font-size: var(--font-md);
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: var(--font-sm);
  color: var(--color-text);
}

.search-clear {
  font-size: var(--font-md);
  color: var(--color-text-light);
  padding: 8rpx;
}

/* 学员列表 */
.student-list {
  margin-top: 8rpx;
}

.student-card {
  display: flex;
  align-items: center;
  background: var(--color-bg-white);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
  position: relative;
}

.student-card:active {
  background: var(--color-bg);
}

/* 头像 */
.student-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.student-avatar image {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-primary);
}

/* 学员信息 */
.student-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.student-name {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text);
}

.student-meta {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

/* 剩余课时 */
.student-lessons {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 16rpx;
}

.lessons-count {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1;
}

.lessons-label {
  font-size: 20rpx;
  color: var(--color-text-light);
  margin-top: 4rpx;
}

/* 箭头 */
.arrow {
  font-size: 36rpx;
  color: var(--color-text-light);
  font-weight: 300;
}

/* FAB 添加按钮 */
.fab-wrapper {
  position: fixed;
  bottom: calc(env(safe-area-inset-bottom) + 140rpx);
  right: 40rpx;
  z-index: 100;
}

.fab {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--color-primary);
  box-shadow: 0 8rpx 24rpx rgba(45, 111, 247, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
  margin: 0;
}

.fab::after {
  border: none;
}

.fab-icon {
  font-size: 48rpx;
  color: #ffffff;
  font-weight: 300;
  line-height: 1;
}
