<!-- pages/coach/students/students.wxml - 学员列表 -->
<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <t-search
      placeholder="搜索学员姓名..."
      value="{{keyword}}"
      bind:change="onSearchChange"
      bind:clear="onClearSearch"
      bind:submit="onSearchSubmit"
    />
  </view>

  <!-- 学员列表 -->
  <view wx:if="{{students.length > 0}}" class="student-list">
    <view
      class="student-card"
      wx:for="{{students}}"
      wx:key="_id"
      bindtap="onTapStudent"
      data-id="{{item._id}}"
    >
      <view class="student-avatar">
        <image wx:if="{{item.avatar_url}}" src="{{item.avatar_url}}" mode="aspectFill" />
        <text wx:else class="avatar-placeholder">{{item.name[0]}}</text>
      </view>
      <view class="student-info">
        <text class="student-name">{{item.name}}</text>
        <text class="student-meta">
          <text wx:if="{{item.last_lesson_date}}">最近上课：{{item.last_lesson_date}}</text>
          <text wx:else class="text-muted">暂无上课记录</text>
        </text>
      </view>
      <view class="student-lessons">
        <text class="lessons-count">{{item.remaining_lessons || 0}}</text>
        <text class="lessons-label">剩余课时</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <t-loading theme="circular" size="48rpx" text="加载中..." />
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{students.length === 0}}" class="empty-wrap">
    <t-empty
      icon="user"
      description="{{keyword ? '没有搜索到匹配的学员' : '还没有添加学员'}}"
    />
    <t-button
      wx:if="{{!keyword}}"
      theme="primary"
      size="medium"
      style="margin-top: 32rpx;"
      bind:tap="onAddStudent"
    >添加第一位学员</t-button>
  </view>

  <!-- 添加 FAB -->
  <view class="fab" wx:if="{{students.length > 0}}" bindtap="onAddStudent">
    <text class="fab-icon">＋</text>
    <text class="fab-text">添加</text>
  </view>
</view>
