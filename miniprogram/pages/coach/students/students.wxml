<view class="page">
  <view class="panel section">
    <input class="input" placeholder="搜索学员" value="{{keyword}}" bindinput="onSearch" />
    <button class="primary-button add" bindtap="addStudent">添加学员</button>
  </view>

  <block wx:for="{{students}}" wx:key="_id">
    <view class="student-row" data-id="{{item._id}}" bindtap="openStudent">
      <view class="name">{{item.name}}</view>
      <view class="muted">剩余 {{item.remaining_lessons || 0}} 节 · 最近上课：{{item.last_lesson_date || '暂无'}}</view>
      <view class="tags">
        <text wx:if="{{item.remaining_lessons <= 2}}" class="tag">低课时</text>
        <text wx:if="{{item.pending_summary_count > 0}}" class="tag">总结未完成</text>
      </view>
    </view>
  </block>

  <view wx:if="{{!students.length && !loading}}" class="panel empty">还没有学员，先添加一个学员档案。</view>
</view>
