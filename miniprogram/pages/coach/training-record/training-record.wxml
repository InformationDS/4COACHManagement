<!-- pages/coach/training-record/training-record.wxml -->
<view class="container">

  <view wx:if="{{loading}}" class="loading-wrap">
    <t-loading theme="circular" size="48rpx" text="加载中..." />
  </view>

  <block wx:if="{{!loading && lesson._id}}">

    <!-- 课程信息 -->
    <view class="card compact-card">
      <view class="info-row">
        <text class="info-label">学员</text>
        <text class="info-value">{{lesson.student_name}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">日期</text>
        <text class="info-value">{{lesson.date}} {{lesson.start_time}}-{{lesson.end_time}}</text>
      </view>
      <button class="ai-workbench-btn mt-16" bindtap="onOpenAiAssistant">在 AI 助手中处理这节课</button>
      <view wx:if="{{existingRecord}}" class="info-tip mt-8">✏️ 编辑已有训练记录</view>
    </view>

    <!-- ===== 录入区：语音按钮 + 文本框 同时可见 ===== -->
    <view wx:if="{{!existingRecord}}" class="card mt-16">
      <view class="card-header">录入训练内容</view>

      <!-- 语音按钮 -->
      <view class="record-section">
        <view
          class="record-btn {{recording ? 'active' : ''}}"
          bindtouchstart="onRecordStart"
          bindtouchend="onRecordStop"
        >
          <text class="record-icon">{{recording ? '⏺️' : '🎙️'}}</text>
          <text class="record-label">{{recording ? '录音中 ' + recordDuration + 's' : '长按录音'}}</text>
        </view>
        <text class="record-hint">松手停止，然后根据口述内容输入文字</text>
      </view>

      <!-- 文本输入 -->
      <view class="text-section">
        <textarea
          class="form-textarea"
          style="min-height: 220rpx;"
          placeholder="输入或粘贴训练内容，例：&#10;今天练胸，杠铃卧推 60kg 4组12次，&#10;上斜哑铃飞鸟 15kg 3组15次，&#10;龙门架夹胸收尾。小明状态不错。"
          value="{{textInput}}"
          bindinput="onTextInput"
          maxlength="500"
        ></textarea>
      </view>

      <!-- AI 解析按钮 -->
      <view class="mt-16" wx:if="{{textInput}}">
        <t-button theme="primary" size="medium" block bind:tap="onParseWithAI" loading="{{parsing}}">AI 智能解析</t-button>
        <view wx:if="{{parseError}}" class="text-sm text-danger mt-8">{{parseError}}</view>
      </view>
    </view>

    <!-- 降级提示 -->
    <view wx:if="{{degraded && !existingRecord}}" class="degraded-tip mt-16">
      <text>⚠️ AI 服务暂不可用，请手动填写下方训练内容</text>
    </view>

    <!-- ===== 结构化表单（AI解析后或有已有记录时展示） ===== -->
    <block wx:if="{{parseResult || existingRecord}}">

      <!-- 训练部位 -->
      <view class="card mt-16">
        <view class="card-header">训练部位</view>
        <view class="tag-grid">
          <view
            wx:for="{{allBodyParts}}"
            wx:key="*this"
            class="tag-select {{bodyPartsMap[item] ? 'active' : ''}}"
            data-part="{{item}}"
            bindtap="onToggleBodyPart"
          >{{item}}</view>
        </view>
      </view>

      <!-- 动作明细 -->
      <view class="card mt-16">
        <view class="card-header flex-between">
          <text>动作明细</text>
          <text class="text-sm text-primary" bindtap="onAddExercise">+ 添加动作</text>
        </view>

        <view wx:if="{{exercises.length === 0}}" class="text-muted text-sm text-center py-16">
          暂无动作，点击上方添加
        </view>

        <view wx:for="{{exercises}}" wx:key="index" class="exercise-row">
          <view class="ex-header">
            <text class="ex-index">动作 {{index + 1}}</text>
            <view class="ex-remove" data-index="{{index}}" bindtap="onRemoveExercise">✕</view>
          </view>
          <view class="ex-fields">
            <view class="ex-field name-field">
              <text class="field-label">动作名称</text>
              <input class="form-input" placeholder="如 杠铃卧推" value="{{item.name}}"
                data-index="{{index}}" data-field="name" bindinput="onExerciseFieldChange" />
            </view>
            <view class="ex-field-row">
              <view class="ex-field num-field">
                <text class="field-label">组数</text>
                <input class="form-input" type="number" placeholder="0" value="{{item.sets}}"
                  data-index="{{index}}" data-field="sets" bindinput="onExerciseFieldChange" />
              </view>
              <view class="ex-field num-field">
                <text class="field-label">次数</text>
                <input class="form-input" type="number" placeholder="0" value="{{item.reps}}"
                  data-index="{{index}}" data-field="reps" bindinput="onExerciseFieldChange" />
              </view>
              <view class="ex-field weight-field">
                <text class="field-label">重量</text>
                <input class="form-input" placeholder="如 60kg" value="{{item.weight}}"
                  data-index="{{index}}" data-field="weight" bindinput="onExerciseFieldChange" />
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 课堂备注 -->
      <view class="card mt-16">
        <view class="card-header">课堂备注</view>
        <textarea class="form-textarea" placeholder="学员状态、注意事项等..."
          value="{{notes}}" bindinput="onNotesInput" maxlength="300" auto-height></textarea>
      </view>

      <!-- 保存按钮 -->
      <view class="save-bar safe-bottom">
        <t-button theme="primary" size="large" block loading="{{saving}}" bind:tap="onSave">
          {{existingRecord ? '更新训练记录' : '保存训练记录'}}
        </t-button>
      </view>
    </block>

    <!-- 无解析结果时只显示空表单入口 -->
    <block wx:if="{{!parseResult && !existingRecord && !textInput}}">
      <view class="empty-state" style="padding: 40rpx 0;">
        <text class="empty-state-text">👆 输入训练内容后点击 AI 解析</text>
        <text class="text-sm text-muted mt-8">或跳过录入，直接</text>
        <button class="btn btn-outline btn-sm mt-16" bindtap="onParseWithAI" disabled>请先输入内容</button>
      </view>
    </block>

    <!-- 有文字但还未解析时 -->
    <block wx:if="{{!parseResult && !existingRecord && textInput}}">
      <view class="empty-state" style="padding: 24rpx 0;">
        <text class="text-sm text-muted">👆 点击上方「AI 智能解析」按钮</text>
      </view>
    </block>

  </block>
</view>
