/* pages/coach/training-record/training-record.wxss — FORGE 主题 */

/* ===== 加载 ===== */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}

/* ===== 课程信息卡片 ===== */
.compact-card {
  padding: 20rpx 28rpx;
}

.info-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.info-label {
  width: 100rpx;
  font-size: 26rpx;
  color: var(--color-text-muted);
}

.info-value {
  font-size: var(--text-md);
  color: var(--color-text);
  font-weight: 500;
}

.info-tip {
  font-size: var(--text-sm);
  color: var(--color-warning);
  text-align: center;
}

/* ===== 录音按钮 ===== */
.record-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 16rpx;
}

.record-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--color-brand-light);
  border: 3rpx solid var(--color-brand);
  transition: all 0.2s;
}

.record-btn.active {
  background: #FDEDEC;
  border-color: var(--color-danger);
  transform: scale(1.08);
  box-shadow: 0 0 0 8rpx rgba(231, 76, 60, 0.15);
  animation: pulse-rec 1.2s ease-in-out infinite;
}

@keyframes pulse-rec {
  0%, 100% { box-shadow: 0 0 0 8rpx rgba(231, 76, 60, 0.15); }
  50%      { box-shadow: 0 0 0 20rpx rgba(231, 76, 60, 0.05); }
}

.record-icon {
  font-size: 48rpx;
}

.record-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.record-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.text-section {
  margin-top: var(--space-xs);
}

/* ===== 降级提示 ===== */
.degraded-tip {
  padding: 20rpx 28rpx;
  background: var(--color-warning-light);
  border: 2rpx solid var(--color-warning);
  border-radius: var(--td-radius-default);
  font-size: 26rpx;
  color: #C2780A;
}

/* ===== 部位标签 ===== */
.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  padding: var(--space-xs) 0;
}

.tag-select {
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg-active);
  border: 2rpx solid var(--color-border);
  border-radius: 9999rpx;
  transition: all 0.2s;
}

.tag-select.active {
  color: var(--color-brand);
  background: var(--color-brand-light);
  border-color: var(--color-brand);
}

/* ===== 动作明细 ===== */
.exercise-row {
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--color-divider);
}

.exercise-row:last-child {
  border-bottom: none;
}

.ex-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.ex-index {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-brand);
}

.ex-remove {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--color-danger);
  background: var(--color-danger-light);
  border-radius: 50%;
}

.ex-fields {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ex-field {
  display: flex;
  flex-direction: column;
}

.field-label {
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-bottom: 4rpx;
}

.ex-field-row {
  display: flex;
  gap: var(--space-sm);
}

.num-field { flex: 1; }
.weight-field { flex: 1.5; }
.name-field { flex: 1; }

.num-field .form-input,
.weight-field .form-input {
  height: 64rpx;
  padding: 0 var(--space-sm);
  font-size: 26rpx;
  text-align: center;
}

.name-field .form-input {
  text-align: left;
}

/* ===== 保存 ===== */
.save-bar {
  padding: var(--space-lg) 0;
}

/* ===== 工具类 ===== */
.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}
