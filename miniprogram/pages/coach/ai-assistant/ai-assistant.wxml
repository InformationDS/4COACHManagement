<view class="ai-page">
  <view class="today-panel">
    <view class="today-title">今日 {{today.todayLessonCount}} 节课</view>
    <view class="today-meta">
      <text wx:if="{{today.nextLesson}}">下一节 {{today.nextLesson.time}} {{today.nextLesson.student_name}}</text>
      <text wx:else>今天还没有后续课程</text>
      <text>总结未完成 {{today.pendingSummaryCount}} 条</text>
    </view>
  </view>

  <scroll-view class="message-list" scroll-y scroll-with-animation scroll-into-view="{{scrollIntoView}}">
    <block wx:for="{{messages}}" wx:key="id">
      <view id="msg-{{index}}">
        <ai-card-renderer message="{{item}}" bind:confirm="confirmCard" bind:cancel="cancelCard" />
      </view>
    </block>
    <view class="message-bottom-space"></view>
  </scroll-view>

  <view class="composer">
    <scroll-view class="quick-actions" scroll-x>
      <block wx:for="{{quickActions}}" wx:key="text">
        <view class="quick-chip" data-prompt="{{item.prompt}}" bindtap="sendQuick">{{item.text}}</view>
      </block>
    </scroll-view>
    <view wx:if="{{voiceHint}}" class="voice-hint">{{voiceHint}}</view>
    <view class="input-panel">
      <textarea class="chat-input" auto-height maxlength="500" placeholder="和 AI 教练说点什么..." value="{{inputText}}" bindinput="onInput" />
      <view class="input-actions">
        <button class="voice-button" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd">语音暂不可用</button>
        <button class="send-button" loading="{{sending}}" bindtap="sendMessage">发送</button>
      </view>
    </view>
  </view>
</view>
