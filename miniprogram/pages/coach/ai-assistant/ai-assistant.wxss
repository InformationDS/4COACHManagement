.ai-page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(360rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.today-panel {
  background: #1a1a2e;
  color: #ffffff;
  border-radius: 18rpx;
  padding: 26rpx;
  margin-bottom: 22rpx;
}

.today-title {
  font-size: 38rpx;
  font-weight: 700;
}

.today-meta {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
  color: rgba(255,255,255,0.78);
  font-size: 24rpx;
}

.message-list {
  height: calc(100vh - 520rpx);
  box-sizing: border-box;
}

.message-bottom-space {
  height: 32rpx;
}

.composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(104rpx + env(safe-area-inset-bottom));
  z-index: 20;
  padding: 14rpx 24rpx 20rpx;
  background: #f0f2f5;
  box-sizing: border-box;
}

.quick-actions {
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.quick-chip {
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 22rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #1a1a2e;
  font-size: 24rpx;
}

.voice-hint {
  margin-bottom: 10rpx;
  color: #cc4921;
  font-size: 24rpx;
}

.input-panel {
  padding: 14rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.chat-input {
  display: block;
  width: 100%;
  min-height: 80rpx;
  max-height: 180rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #f7f8fa;
  box-sizing: border-box;
}

.input-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.voice-button,
.send-button {
  margin: 0;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.voice-button {
  flex: 1;
  color: #1a1a2e;
  background: #f0f2f5;
}

.send-button {
  width: 220rpx;
  color: #ffffff;
  background: #ff6b35;
}
