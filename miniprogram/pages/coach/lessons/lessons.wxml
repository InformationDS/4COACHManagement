<view class="page">
  <view class="section panel">
    <view class="row between">
      <picker mode="date" value="{{selectedDate}}" bindchange="changeDate">
        <view class="date-picker">{{selectedDate}}</view>
      </picker>
      <button class="primary-button small" bindtap="openForm">新建课程</button>
    </view>
    <view class="segments">
      <view class="segment {{viewMode === 'day' ? 'active' : ''}}" data-mode="day" bindtap="switchMode">日</view>
      <view class="segment {{viewMode === 'week' ? 'active' : ''}}" data-mode="week" bindtap="switchMode">周</view>
      <view class="segment {{viewMode === 'month' ? 'active' : ''}}" data-mode="month" bindtap="switchMode">月</view>
    </view>
    <view wx:if="{{viewMode === 'week'}}" class="stats">本周 {{weekStats.total}} 节课 · 已完成 {{weekStats.completed}} 节 · 待上课 {{weekStats.pending}} 节</view>
  </view>

  <view class="section">
    <block wx:for="{{lessons}}" wx:key="_id">
      <view class="lesson-row" data-id="{{item._id}}" bindtap="openLesson">
        <view class="time">{{item.start_time}}-{{item.end_time}}</view>
        <view class="info">
          <view class="name">{{item.student_name}}</view>
          <view class="muted">{{item.training_plan && item.training_plan.theme ? item.training_plan.theme : '待补方案'}} · {{item.summary_status === 'completed' ? '总结已完成' : '总结未完成'}}</view>
        </view>
        <view class="tag">{{item.status_text}}</view>
      </view>
    </block>
    <view wx:if="{{!lessons.length && !loading}}" class="empty panel">
      <view>这段时间还没有课程</view>
      <button class="ghost-button small" bindtap="askAiSchedule">问 AI 排课</button>
    </view>
  </view>

  <view wx:if="{{cancelledLessons.length}}" class="section panel">
    <view class="muted">已取消课程 {{cancelledLessons.length}}</view>
    <block wx:for="{{cancelledLessons}}" wx:key="_id">
      <view class="cancelled">{{item.start_time}}-{{item.end_time}} {{item.student_name}}</view>
    </block>
  </view>
</view>
