<!-- pages/coach/lessons/lessons.wxml -->
<view class="container">
  <!-- 日历组件 -->
  <calendar lessons="{{lessons}}" value="{{selectedDate}}" bind:change="onCalendarChange" />

  <!-- 当日课程列表 -->
  <view class="section-header mt-24">
    <text class="section-title">{{selectedDate}} 课程</text>
    <text class="section-count">共 {{todayLessons.length}} 节</text>
  </view>

  <view wx:if="{{todayLessons.length > 0}}">
    <lesson-card
      wx:for="{{todayLessons}}"
      wx:key="_id"
      lesson="{{item}}"
      bind:lessontap="onLessonTap"
    />
  </view>
  <view wx:else class="empty-state" style="padding: 60rpx 0;">
    <text class="empty-state-text">当日暂无课程</text>
  </view>

  <!-- 排课 FAB -->
  <view class="fab" bindtap="onCreateLesson">
    <text class="fab-icon">＋</text>
    <text class="fab-text">排课</text>
  </view>

  <!-- ===== 排课弹窗 ===== -->
  <view class="modal-wrapper" wx:if="{{showCreateModal}}" catchtouchmove="noop">
    <view class="modal-mask" bindtap="onCloseCreate"></view>
    <view class="modal-center">
      <view class="modal-content">
        <view class="modal-header">
          <text class="modal-title">排课</text>
          <view class="modal-close" bindtap="onCloseCreate">✕</view>
        </view>
        <view class="form-group mt-16">
          <text class="form-label">日期</text>
          <input class="form-input" value="{{selectedDate}}" disabled />
        </view>
        <view class="form-group">
          <text class="form-label">选择学员</text>
          <picker range="{{studentNames}}" value="{{studentIdx}}" bindchange="onStudentPickerChange">
            <view class="form-input picker-display">
              {{studentNames[studentIdx] || '请选择学员'}}
            </view>
          </picker>
        </view>
        <time-grid
          duration="{{lessonDuration}}"
          occupied="{{occupiedSlots}}"
          bind:change="onTimeChange"
        />
        <view class="form-group mt-16">
          <text class="form-label">上课地点</text>
          <picker range="{{locations}}" value="{{locationIdx}}" bindchange="onLocationPickerChange">
            <view class="form-input picker-display">
              {{locations[locationIdx] || '请选择地点'}}
            </view>
          </picker>
        </view>
        <view class="modal-actions mt-24">
          <t-button theme="default" variant="outline" size="medium" class="flex-1" bind:tap="onCloseCreate">取消</t-button>
          <t-button theme="primary" size="medium" class="flex-1 ml-16" loading="{{creating}}" bind:tap="onConfirmCreate">确认排课</t-button>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 课程详情弹窗 ===== -->
  <t-popup
    visible="{{showDetailModal}}"
    placement="bottom"
    bind:visible-change="onDetailVisibleChange"
    close-on-overlay-click
  >
    <view class="detail-popup">
      <view class="detail-popup-header">
        <text class="detail-popup-title">课程详情</text>
      </view>

      <view class="detail-row">
        <text class="detail-label">学员</text>
        <text class="detail-value">{{detailLesson.student_name}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">时间</text>
        <text class="detail-value">{{detailLesson.date}} {{detailLesson.start_time}}-{{detailLesson.end_time}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">地点</text>
        <text class="detail-value">{{detailLesson.location || '未指定'}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">状态</text>
        <t-tag
          wx:if="{{detailLesson.status === 'pending'}}"
          theme="warning" variant="light" size="small"
        >待确认</t-tag>
        <t-tag
          wx:elif="{{detailLesson.status === 'confirmed'}}"
          theme="primary" variant="light" size="small"
        >已确认</t-tag>
        <t-tag
          wx:elif="{{detailLesson.status === 'completed'}}"
          theme="success" variant="light" size="small"
        >已完成</t-tag>
        <t-tag
          wx:elif="{{detailLesson.status === 'cancelled'}}"
          theme="default" variant="light" size="small"
        >已取消</t-tag>
      </view>
      <view wx:if="{{detailLesson.cancel_reason}}" class="detail-row">
        <text class="detail-label">取消原因</text>
        <text class="detail-value text-muted">{{detailLesson.cancel_reason}}</text>
      </view>

      <!-- 操作按钮 -->
      <view class="detail-actions" wx:if="{{detailLesson.status==='pending' || detailLesson.status==='confirmed'}}">
        <block wx:if="{{detailLesson.status==='pending'}}">
          <t-button theme="primary" size="medium" class="flex-1" bind:tap="onConfirmLesson">确认</t-button>
          <t-button theme="default" variant="outline" size="medium" class="flex-1 ml-16" bind:tap="onCancelLesson">取消</t-button>
        </block>
        <block wx:if="{{detailLesson.status==='confirmed'}}">
          <t-button theme="primary" size="medium" class="flex-1" bind:tap="onCompleteLesson">标记完成</t-button>
          <t-button theme="default" variant="outline" size="medium" class="flex-1 ml-16" bind:tap="onCancelLesson">取消课程</t-button>
        </block>
      </view>

      <!-- 已完成课程：训练记录入口 -->
      <view class="detail-actions" wx:if="{{detailLesson.status==='completed'}}">
        <t-button theme="primary" size="medium" block bind:tap="onTrainingRecord">记录训练</t-button>
      </view>
    </view>
  </t-popup>

  <!-- ===== 取消课程弹窗（输入原因） ===== -->
  <t-dialog
    visible="{{showCancelModal}}"
    title="取消课程"
    confirm-btn="确认取消"
    cancel-btn="返回"
    bind:confirm="onConfirmCancel"
    bind:cancel="onCloseCancelModal"
    bind:close="onCloseCancelModal"
  >
    <view class="cancel-dialog-body" slot="content">
      <text class="form-label">取消原因（选填）</text>
      <textarea
        class="form-textarea"
        placeholder="请输入取消原因（如：临时有事、学员请假...）"
        value="{{cancelReason}}"
        bindinput="onCancelReasonInput"
        maxlength="100"
        auto-height
      ></textarea>
    </view>
  </t-dialog>
</view>
