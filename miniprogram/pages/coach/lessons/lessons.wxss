.small {
  margin: 0;
  min-width: 152rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
}

.date-picker {
  font-size: 34rpx;
  font-weight: 700;
}

.segments {
  display: flex;
  margin-top: 22rpx;
  background: #f0f2f5;
  border-radius: 12rpx;
  padding: 6rpx;
}

.segment {
  flex: 1;
  height: 58rpx;
  line-height: 58rpx;
  text-align: center;
  border-radius: 10rpx;
  color: #6b7280;
}

.segment.active {
  background: #ffffff;
  color: #ff6b35;
  font-weight: 700;
}

.stats {
  margin-top: 18rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.lesson-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 112rpx;
  margin-bottom: 16rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.time {
  width: 150rpx;
  color: #1a1a2e;
  font-weight: 700;
  font-size: 24rpx;
}

.info {
  flex: 1;
}

.name {
  margin-bottom: 6rpx;
  font-weight: 700;
}

.empty {
  text-align: center;
  color: #6b7280;
}

.cancelled {
  padding-top: 14rpx;
  color: #9ca3af;
}
