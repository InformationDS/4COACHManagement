<view class="page">
  <view class="panel section">
    <view class="form-field"><text class="form-label">姓名</text><input class="input" value="{{form.name}}" data-key="name" bindinput="inputField" /></view>
    <view class="form-field"><text class="form-label">手机号</text><input class="input" value="{{form.phone}}" data-key="phone" bindinput="inputField" /></view>
    <view class="form-field"><text class="form-label">剩余课时</text><input class="input" type="digit" value="{{form.remaining_lessons}}" data-key="remaining_lessons" bindinput="inputField" /></view>
    <view class="form-field"><text class="form-label">常用上课地点</text><input class="input" value="{{form.default_location}}" data-key="default_location" bindinput="inputField" /></view>
    <view class="form-field"><text class="form-label">训练目标</text><textarea class="textarea" value="{{form.goal}}" data-key="goal" bindinput="inputField" /></view>
    <view class="form-field"><text class="form-label">伤病 / 禁忌</text><textarea class="textarea" value="{{form.injuries}}" data-key="injuries" bindinput="inputField" /></view>
    <view class="form-field"><text class="form-label">备注</text><textarea class="textarea" value="{{form.notes}}" data-key="notes" bindinput="inputField" /></view>
    <button class="primary-button" bindtap="save">保存学员</button>
  </view>

  <view wx:if="{{studentId}}" class="panel section">
    <view class="segments">
      <text class="{{tab === 'overview' ? 'active' : ''}}" data-tab="overview" bindtap="switchTab">概览</text>
      <text class="{{tab === 'courses' ? 'active' : ''}}" data-tab="courses" bindtap="switchTab">课程</text>
      <text class="{{tab === 'summaries' ? 'active' : ''}}" data-tab="summaries" bindtap="switchTab">总结</text>
      <text class="{{tab === 'data' ? 'active' : ''}}" data-tab="data" bindtap="switchTab">数据</text>
      <text class="{{tab === 'notes' ? 'active' : ''}}" data-tab="notes" bindtap="switchTab">备注</text>
    </view>
    <view wx:if="{{tab === 'overview'}}" class="tab-body">
      <view>剩余课时：{{form.remaining_lessons || 0}}</view>
      <view>近 30 天课程：{{lessons.length}}</view>
    </view>
    <view wx:elif="{{tab === 'courses'}}" class="tab-body">
      <block wx:for="{{lessons}}" wx:key="_id"><view class="line">{{item.date}} {{item.start_time}} {{item.status_text}}</view></block>
    </view>
    <view wx:elif="{{tab === 'summaries'}}" class="tab-body">
      <block wx:for="{{summaries}}" wx:key="_id"><view class="line">{{item.title || item.theme || '课程总结'}}</view></block>
    </view>
    <view wx:elif="{{tab === 'data'}}" class="tab-body">
      <view>累计课程数：{{lessons.length}}</view>
      <view>常练动作会基于标准动作名称统计。</view>
    </view>
    <view wx:else class="tab-body">{{form.notes || '未填写'}}</view>
  </view>

  <view wx:if="{{studentId}}" class="panel section">
    <view class="title">课时管理</view>
    <input class="input" type="digit" placeholder="课时数量" value="{{balanceAmount}}" bindinput="inputBalanceAmount" />
    <input class="input reason" placeholder="原因" value="{{balanceReason}}" bindinput="inputBalanceReason" />
    <view class="row between">
      <button class="primary-button half-btn" data-type="recharge" bindtap="adjustBalance">充值</button>
      <button class="ghost-button half-btn" data-type="manual_deduct" bindtap="adjustBalance">手动扣减</button>
    </view>
    <block wx:for="{{balanceLogs}}" wx:key="_id"><view class="line">{{item.type_text}} {{item.amount}} · {{item.reason}}</view></block>
  </view>
</view>
