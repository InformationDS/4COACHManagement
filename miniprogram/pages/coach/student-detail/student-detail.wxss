.segments {
  display: flex;
  justify-content: space-between;
  color: #6b7280;
}

.segments text {
  padding: 14rpx 0;
}

.segments .active {
  color: #ff6b35;
  font-weight: 700;
}

.tab-body {
  margin-top: 20rpx;
  line-height: 1.8;
}

.line {
  padding: 14rpx 0;
  border-top: 1rpx solid #eef0f3;
}

.title {
  margin-bottom: 18rpx;
  font-weight: 700;
}

.reason {
  margin-top: 16rpx;
}

.half-btn {
  width: 48%;
  margin: 18rpx 0 0;
}
