<view class="page">
  <view class="panel section">
    <view class="coach-name">{{coach.nick_name || '私人教练'}}</view>
    <view class="muted">当前身份：教练</view>
  </view>
  <view class="panel section">
    <view class="form-field">
      <text class="form-label">默认课时时长（分钟）</text>
      <input class="input" type="number" value="{{defaultDuration}}" bindinput="inputDuration" />
    </view>
    <button class="primary-button" bindtap="saveSettings">保存默认设置</button>
  </view>
  <view class="panel section item" bindtap="openActionLibrary">动作库管理</view>
  <view class="panel section">
    <view class="form-label">使用反馈</view>
    <textarea class="textarea" placeholder="写下遇到的问题或建议" value="{{feedback}}" bindinput="inputFeedback" />
    <button class="ghost-button feedback" bindtap="submitFeedback">提交反馈</button>
  </view>
</view>
