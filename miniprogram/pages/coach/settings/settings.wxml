<!-- pages/coach/settings/settings.wxml -->
<view class="container">
  <view wx:if="{{loading}}" class="loading-wrap">
    <t-loading theme="circular" size="48rpx" text="加载中..." />
  </view>

  <block wx:else>
    <view class="card">
      <view class="card-header">课程时长</view>
      <view class="duration-row">
        <input class="duration-input" type="number" value="{{settings.lesson_duration}}" bindinput="onDurationInput" />
        <text class="duration-unit">分钟 / 节</text>
      </view>
    </view>

    <view class="card">
      <view class="card-header">每日工作时间</view>
      <view class="form-row">
        <view class="form-group flex-1">
          <text class="form-label">开始</text>
          <input class="form-input" type="time" value="{{settings.daily_start_time}}" bindinput="onDailyStartInput" />
        </view>
        <view class="form-group flex-1 ml-16">
          <text class="form-label">结束</text>
          <input class="form-input" type="time" value="{{settings.daily_end_time}}" bindinput="onDailyEndInput" />
        </view>
      </view>
    </view>

    <view class="card">
      <view class="card-header">常用上课地点</view>
      <view wx:if="{{settings.common_locations.length > 0}}">
        <view class="location-item" wx:for="{{settings.common_locations}}" wx:key="*this">
          <text class="location-name">{{item}}</text>
          <text class="location-delete" data-index="{{index}}" bindtap="onDeleteLocation">删除</text>
        </view>
      </view>
      <view wx:else class="text-muted text-sm text-center py-24">暂无地点</view>
      <view class="add-row mt-16">
        <input class="add-input" placeholder="输入地点名称" value="{{newLocation}}" bindinput="onLocationInput" />
        <t-button theme="primary" size="medium" bind:tap="onAddLocation">添加</t-button>
      </view>
    </view>

    <view class="safe-bottom" style="padding: var(--space-lg) 0 0;">
      <t-button theme="primary" size="large" block loading="{{saving}}" bind:tap="onSave">保存设置</t-button>
    </view>
  </block>
</view>
