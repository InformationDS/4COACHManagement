<!-- pages/coach/settings/settings.wxml -->
<view class="container">
  <view wx:if="{{loading}}" class="loading-wrap">
    <t-loading theme="circular" size="48rpx" text="加载中..." />
  </view>

  <block wx:else>
    <view class="card">
      <view class="card-header">教练信息</view>
      <view class="form-group">
        <text class="form-label">姓名</text>
        <input
          class="form-input"
          placeholder="请输入姓名"
          value="{{profile.name}}"
          data-field="name"
          bindinput="onProfileInput"
        />
      </view>
      <view class="form-group">
        <text class="form-label">手机号</text>
        <input
          class="form-input"
          type="number"
          maxlength="11"
          placeholder="请输入手机号"
          value="{{profile.phone}}"
          data-field="phone"
          bindinput="onProfileInput"
        />
      </view>
    </view>

    <view class="card">
      <view class="card-header">课程时长</view>
      <view class="duration-row">
        <input class="duration-input" type="number" value="{{settings.lesson_duration}}" bindinput="onDurationInput" />
        <text class="duration-unit">分钟 / 节</text>
      </view>
    </view>

    <view class="card">
      <view class="card-header">常用上课地点</view>
      <view wx:if="{{settings.common_locations.length > 0}}">
        <view class="location-item" wx:for="{{settings.common_locations}}" wx:key="*this">
          <text class="location-name">{{item}}</text>
          <text class="location-delete" data-index="{{index}}" bindtap="onDeleteLocation">删除</text>
        </view>
      </view>
      <view wx:else class="text-muted text-sm text-center py-24">暂无地点</view>
      <view class="add-row mt-16">
        <input class="add-input" placeholder="输入地点名称" value="{{newLocation}}" bindinput="onLocationInput" />
        <t-button theme="primary" size="medium" bind:tap="onAddLocation">添加</t-button>
      </view>
    </view>

    <view class="card">
      <view class="card-header">AI 助手状态</view>
      <view class="ai-status-row">
        <text class="ai-status-label">文本 AI</text>
        <text class="ai-status-value {{aiStatus.aiAvailable ? 'ok' : 'bad'}}">{{aiStatus.aiAvailable ? '可用' : '不可用'}}</text>
      </view>
      <view class="ai-status-row">
        <text class="ai-status-label">语音转写</text>
        <text class="ai-status-value {{aiStatus.voiceAvailable ? 'ok' : 'warn'}}">{{aiStatus.voiceAvailable ? '可用' : '暂未接入'}}</text>
      </view>
      <view class="ai-status-row">
        <text class="ai-status-label">模型通道</text>
        <text class="ai-status-value">{{aiStatus.modelMode}}</text>
      </view>
      <text class="ai-status-note">{{aiStatus.message}}</text>
    </view>

    <view class="safe-bottom" style="padding: var(--space-lg) 0 0;">
      <t-button theme="primary" size="large" block loading="{{saving}}" bind:tap="onSave">保存</t-button>
    </view>
  </block>
</view>
