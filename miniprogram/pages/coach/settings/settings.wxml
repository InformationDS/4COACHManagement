<!-- pages/coach/settings/settings.wxml -->
<view class="container">
  <!-- 课程时长 -->
  <view class="card">
    <view class="card-header">课程时长</view>
    <view class="duration-row">
      <input class="duration-input" type="number" value="{{settings.lesson_duration}}" bindinput="onDurationInput" />
      <text class="duration-unit">分钟 / 节</text>
    </view>
  </view>

  <!-- 每日工作时间 -->
  <view class="card">
    <view class="card-header">每日工作时间</view>
    <view class="form-row">
      <view class="form-group flex-1">
        <text class="form-label">开始</text>
        <input class="form-input" type="time" value="{{settings.daily_start_time}}" bindinput="onDailyStartInput" />
      </view>
      <view class="form-group flex-1 ml-16">
        <text class="form-label">结束</text>
        <input class="form-input" type="time" value="{{settings.daily_end_time}}" bindinput="onDailyEndInput" />
      </view>
    </view>
  </view>

  <!-- 循环不可约（每周固定） -->
  <view class="card">
    <view class="card-header">循环不可约（每周固定）</view>
    <view wx:if="{{recurringBlocks.length > 0}}">
      <view class="block-item" wx:for="{{recurringBlocks}}" wx:key="_idx">
        <view class="block-info">
          <text class="block-days">周{{item.daysText}}</text>
          <text class="block-time">{{item.timeText}}</text>
          <text class="block-note" wx:if="{{item.note}}">{{item.note}}</text>
        </view>
        <view class="block-delete" data-index="{{item._idx}}" bindtap="onDeleteRecurring">删除</view>
      </view>
    </view>
    <view wx:else class="text-muted text-sm text-center py-24">暂无循环规则，点击下方添加</view>
    <t-button theme="default" variant="outline" size="medium" block style="margin-top: var(--space-sm)" bind:tap="onOpenRecurring">+ 添加循环规则</t-button>
  </view>

  <!-- 特定日期不可约 -->
  <view class="card">
    <view class="card-header">特定日期不可约</view>
    <view wx:if="{{dateBlocks.length > 0}}">
      <view class="block-item" wx:for="{{dateBlocks}}" wx:key="_idx">
        <view class="block-info">
          <text class="block-days">{{item.date}}</text>
          <text class="block-time">{{item.timeText}}</text>
          <text class="block-note" wx:if="{{item.note}}">{{item.note}}</text>
        </view>
        <view class="block-delete" data-index="{{item._idx}}" bindtap="onDeleteDateBlock">删除</view>
      </view>
    </view>
    <view wx:else class="text-muted text-sm text-center py-24">暂无特定日期屏蔽，点击下方添加</view>
    <t-button theme="default" variant="outline" size="medium" block style="margin-top: var(--space-sm)" bind:tap="onOpenDateBlock">+ 添加特定日期</t-button>
  </view>

  <!-- 常用地点 -->
  <view class="card">
    <view class="card-header">常用上课地点</view>
    <view wx:if="{{settings.common_locations.length > 0}}">
      <view class="location-item" wx:for="{{settings.common_locations}}" wx:key="*this">
        <text class="location-name">📍 {{item}}</text>
        <text class="location-delete" data-index="{{index}}" bindtap="onDeleteLocation">删除</text>
      </view>
    </view>
    <view wx:else class="text-muted text-sm text-center py-24">暂无地点</view>
    <view class="add-row mt-16">
      <input class="add-input" placeholder="输入地点名称" value="{{newLocation}}" bindinput="onLocationInput" />
      <t-button theme="primary" size="medium" bind:tap="onAddLocation">添加</t-button>
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="safe-bottom" style="padding: var(--space-lg) 0 0;">
    <t-button theme="primary" size="large" block loading="{{saving}}" bind:tap="onSave">保存设置</t-button>
  </view>

  <!-- ===== 循环不可约弹窗 ===== -->
  <t-dialog
    visible="{{recurringModal}}"
    title="添加循环规则"
    confirm-btn="确认"
    cancel-btn="取消"
    bind:confirm="onConfirmRecurring"
    bind:cancel="onCloseRecurring"
    bind:close="onCloseRecurring"
  >
    <view class="dialog-body" slot="content">
      <view class="form-group">
        <text class="form-label">选择星期</text>
        <view class="weekday-check">
          <view class="wday-item {{recurringDays[index] ? 'active' : ''}}"
            wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="*this"
            data-day="{{index}}" bindtap="onRecurringDayTap">{{item}}</view>
        </view>
      </view>
      <view class="form-row">
        <view class="form-group flex-1">
          <text class="form-label">开始时间</text>
          <input class="form-input" type="time" value="{{recurringStartTime}}" bindinput="onRecurringStartInput" />
        </view>
        <view class="form-group flex-1 ml-16">
          <text class="form-label">结束时间</text>
          <input class="form-input" type="time" value="{{recurringEndTime}}" bindinput="onRecurringEndInput" />
        </view>
      </view>
      <view class="form-group">
        <text class="form-label">备注（可选）</text>
        <input class="form-input" placeholder="如：午休、自己训练" value="{{recurringNote}}" bindinput="onRecurringNoteInput" />
      </view>
    </view>
  </t-dialog>

  <!-- ===== 特定日期不可约弹窗 ===== -->
  <t-dialog
    visible="{{dateModal}}"
    title="添加特定日期"
    confirm-btn="确认"
    cancel-btn="取消"
    bind:confirm="onConfirmDateBlock"
    bind:cancel="onCloseDateModal"
    bind:close="onCloseDateModal"
  >
    <view class="dialog-body" slot="content">
      <view class="form-group">
        <text class="form-label">选择日期</text>
        <picker mode="date" value="{{dateBlockDate}}" start="2026-01-01" bindchange="onDateChange">
          <view class="form-input picker-display">{{dateBlockDateText}}</view>
        </picker>
      </view>
      <view class="form-group">
        <view class="all-day-row" bindtap="onDateAllDayToggle">
          <text class="all-day-label">全天</text>
          <view class="toggle-box {{dateBlockAllDay ? 'active' : ''}}">
            <view class="toggle-knob"></view>
          </view>
        </view>
      </view>
      <view class="form-row" wx:if="{{!dateBlockAllDay}}">
        <view class="form-group flex-1">
          <text class="form-label">开始时间</text>
          <input class="form-input" type="time" value="{{dateBlockStartTime}}" bindinput="onDateStartInput" />
        </view>
        <view class="form-group flex-1 ml-16">
          <text class="form-label">结束时间</text>
          <input class="form-input" type="time" value="{{dateBlockEndTime}}" bindinput="onDateEndInput" />
        </view>
      </view>
      <view class="form-group">
        <text class="form-label">备注（可选）</text>
        <input class="form-input" placeholder="如：看医生、外出" value="{{dateBlockNote}}" bindinput="onDateNoteInput" />
      </view>
    </view>
  </t-dialog>
</view>
