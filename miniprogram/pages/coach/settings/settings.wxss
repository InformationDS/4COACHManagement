/* pages/coach/settings/settings.wxss — FORGE 主题 */

/* ===== 课程时长 ===== */
.duration-row {
  display: flex;
  align-items: center;
}

.duration-input {
  width: 120rpx;
  height: 72rpx;
  background: var(--color-bg-active);
  border-radius: var(--td-radius-small);
  text-align: center;
  font-size: var(--text-lg);
  font-weight: 600;
  color: var(--color-brand);
}

.duration-unit {
  margin-left: 12rpx;
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
}

/* ===== 每日工作时间 ===== */
.form-row {
  display: flex;
}

/* ===== 不可约时段列表 ===== */
.block-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.block-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.block-days {
  font-size: var(--text-sm);
  color: var(--color-brand);
  font-weight: 500;
}

.block-time {
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.block-note {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  margin-top: 2rpx;
}

.block-delete {
  font-size: var(--text-xs);
  color: var(--color-danger);
  padding: var(--space-xs);
}

/* ===== 常用地点 ===== */
.location-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.location-name {
  font-size: var(--text-sm);
  color: var(--color-text);
}

.location-delete {
  font-size: var(--text-xs);
  color: var(--color-danger);
  padding: var(--space-xs);
}

.add-row {
  display: flex;
  gap: var(--space-sm);
  align-items: center;
}

.add-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  background: var(--color-bg-active);
  border-radius: var(--td-radius-small);
  font-size: var(--text-sm);
}

/* ===== AI status ===== */
.ai-status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.ai-status-label {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
}

.ai-status-value {
  font-size: var(--text-sm);
  color: var(--color-text);
  text-align: right;
}

.ai-status-value.ok {
  color: var(--color-success);
}

.ai-status-value.warn {
  color: var(--color-warning);
}

.ai-status-value.bad {
  color: var(--color-danger);
}

.ai-status-note {
  display: block;
  margin-top: 16rpx;
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  line-height: 1.6;
}

/* ===== 星期选择 ===== */
.weekday-check {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.wday-item {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-active);
  border-radius: 50%;
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  transition: all 0.2s;
}

.wday-item.active {
  background: var(--color-brand);
  color: #fff;
}

/* ===== 全天切换按钮 ===== */
.all-day-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.all-day-label {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
}

.toggle-box {
  width: 88rpx;
  height: 48rpx;
  background: #D1D5DB;
  border-radius: 24rpx;
  position: relative;
  transition: background 0.2s;
}

.toggle-box.active {
  background: var(--color-brand);
}

.toggle-knob {
  width: 40rpx;
  height: 40rpx;
  background: #fff;
  border-radius: 50%;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  transition: left 0.2s;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.15);
}

.toggle-box.active .toggle-knob {
  left: 44rpx;
}

/* ===== Picker 模拟 ===== */
.picker-display {
  display: flex;
  align-items: center;
  color: var(--color-text);
}

/* ===== 调试 ===== */
.debug-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.debug-label {
  font-size: var(--text-sm);
  color: var(--color-text);
}

.debug-picker {
  font-size: var(--text-sm);
  color: var(--color-brand);
  padding: 12rpx 20rpx;
  background: var(--color-brand-light);
  border-radius: var(--td-radius-small);
}

.debug-hint {
  font-size: 20rpx;
  color: var(--color-text-muted);
  text-align: center;
  display: block;
  margin-top: 12rpx;
}

/* ===== Dialog 内容 ===== */
.dialog-body {
  padding: var(--space-xs) 0;
}

/* ===== 通用 ===== */
.py-24 {
  padding: var(--space-md) 0;
}
