page {
  background: #f0f2f5;
  color: #1a1a2e;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
  padding-bottom: calc(128rpx + env(safe-area-inset-bottom));
}

.section {
  margin-bottom: 24rpx;
}

.panel {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  justify-content: space-between;
}

.muted {
  color: #6b7280;
}

.weak {
  color: #9ca3af;
}

.tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #fff0e8;
  color: #cc4921;
  font-size: 22rpx;
  white-space: nowrap;
}

.primary-button {
  background: #ff6b35;
  color: #ffffff;
  border-radius: 12rpx;
  font-weight: 600;
}

.ghost-button {
  background: #ffffff;
  color: #1a1a2e;
  border: 1rpx solid #d1d5db;
  border-radius: 12rpx;
}

.danger {
  color: #e74c3c;
}

.form-field {
  margin-bottom: 22rpx;
}

.form-label {
  display: block;
  margin-bottom: 10rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.input,
.textarea,
.picker {
  min-height: 80rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  padding: 20rpx;
  box-sizing: border-box;
}

.textarea {
  min-height: 160rpx;
  width: 100%;
}
