/* app.wxss - 全局样式 */

/* ===== CSS 变量 / 设计规范 ===== */
page {
  --color-primary: #2d6ff7;
  --color-primary-dark: #1a5ad9;
  --color-primary-light: #e8f0fe;
  --color-success: #22c55e;
  --color-warning: #f59e0b;
  --color-danger: #ef4444;
  --color-text: #1a1a2e;
  --color-text-secondary: #6b7280;
  --color-text-light: #9ca3af;
  --color-bg: #f5f5f5;
  --color-bg-white: #ffffff;
  --color-border: #e5e7eb;
  --color-divider: #f3f4f6;
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --shadow-sm: 0 2rpx 8rpx rgba(0,0,0,0.06);
  --shadow-md: 0 4rpx 16rpx rgba(0,0,0,0.1);
  --font-xs: 22rpx;
  --font-sm: 26rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 36rpx;
  --font-xxl: 44rpx;
}

page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: var(--font-md);
  color: var(--color-text);
  background-color: var(--color-bg);
  line-height: 1.6;
}

/* ===== 通用布局 ===== */
.container {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.flex-1 {
  flex: 1;
}

/* ===== 卡片 ===== */
.card {
  background: var(--color-bg-white);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.card-header {
  font-size: var(--font-lg);
  font-weight: 600;
  margin-bottom: 16rpx;
  color: var(--color-text);
}

.card-body {
  color: var(--color-text-secondary);
}

/* ===== 按钮 ===== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-md);
  font-weight: 500;
  border: none;
  transition: opacity 0.2s;
}

.btn-primary {
  background-color: var(--color-primary);
  color: #fff;
}

.btn-primary:active {
  background-color: var(--color-primary-dark);
}

.btn-danger {
  background-color: var(--color-danger);
  color: #fff;
}

.btn-outline {
  background-color: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}

.btn-ghost {
  background-color: transparent;
  color: var(--color-text-secondary);
}

.btn-sm {
  height: 60rpx;
  padding: 0 24rpx;
  font-size: var(--font-sm);
  border-radius: var(--radius-sm);
}

.btn-block {
  width: 100%;
}

.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* ===== 表单 ===== */
.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
  display: block;
}

.form-label .required {
  color: var(--color-danger);
  margin-left: 4rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  font-size: var(--font-md);
  color: var(--color-text);
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  font-size: var(--font-md);
  color: var(--color-text);
  box-sizing: border-box;
}

/* ===== 状态标签 ===== */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: var(--font-xs);
  font-weight: 500;
}

.tag-pending {
  background: #fef3c7;
  color: #92400e;
}

.tag-confirmed {
  background: #dbeafe;
  color: #1e40af;
}

.tag-completed {
  background: #d1fae5;
  color: #065f46;
}

.tag-cancelled {
  background: #fee2e2;
  color: #991b1b;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-state-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.empty-state-text {
  font-size: var(--font-md);
  color: var(--color-text-light);
  text-align: center;
}

/* ===== 列表项 ===== */
.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: var(--color-bg-white);
  border-bottom: 1rpx solid var(--color-divider);
}

.list-item:last-child {
  border-bottom: none;
}

.list-item:active {
  background: var(--color-bg);
}

.list-item-arrow::after {
  content: '';
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid var(--color-text-light);
  border-right: 3rpx solid var(--color-text-light);
  transform: rotate(45deg);
  margin-left: auto;
}

/* ===== 分割线 ===== */
.divider {
  height: 16rpx;
  background: var(--color-bg);
}

/* ===== 颜色工具 ===== */
.text-primary { color: var(--color-primary); }
.text-success { color: var(--color-success); }
.text-warning { color: var(--color-warning); }
.text-danger  { color: var(--color-danger); }
.text-muted   { color: var(--color-text-light); }
.text-secondary { color: var(--color-text-secondary); }

.text-sm  { font-size: var(--font-sm); }
.text-md  { font-size: var(--font-md); }
.text-lg  { font-size: var(--font-lg); }
.text-xl  { font-size: var(--font-xl); }
.text-xxl { font-size: var(--font-xxl); }

.text-bold { font-weight: 600; }
.text-center { text-align: center; }

.mt-8  { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-8  { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.ml-8  { margin-left: 8rpx; }
.mr-8  { margin-right: 8rpx; }

/* ===== 安全区域 ===== */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
